<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_Besuchstour"
  targetNamespace="https://github.com/thi-projekte/terramax/bpmn"
  exporter="TerraMax" exporterVersion="1.0">
<bpmn:collaboration id="Collaboration_Besuchstour">
<bpmn:participant id="Participant_Besuchstour" name="Besuchstour (TerraMax)" processRef="Besuchstour" />
</bpmn:collaboration>
<bpmn:process id="Besuchstour" name="Besuchstour" isExecutable="true" camunda:candidateStarterGroups="sales_professional" camunda:historyTimeToLive="180"><bpmn:documentation>Geführte Besuchstour des Sales Professional mit Sprachprotokoll (Issue #29). Wartezustände (User Tasks, External Tasks) werden von der Engine gespeichert; die Tour kann nach dem Schließen der App fortgesetzt werden.</bpmn:documentation><bpmn:laneSet id="LaneSet_Besuchstour"><bpmn:lane id="Lane_SalesProfessional" name="Sales Professional"><bpmn:flowNodeRef>StartEvent_TourAngefordert</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_PlanZusammenfuehren</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_BesuchsplanPruefen</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_PlanBestaetigt</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_NochGenugKunden</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_TourVerworfen</bpmn:flowNodeRef><bpmn:flowNodeRef>SubProcess_KundenBesuchen</bpmn:flowNodeRef><bpmn:flowNodeRef>StartEvent_BesuchFaellig</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_BesuchVorbereiten</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_BesuchUeberspringen</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_BesuchDurchfuehren</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SprachnotizAufnehmen</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_SprachnotizVorhanden</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ProtokollZusammenfuehren</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ProtokollPruefen</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TourAbschliessen</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_TourAbgeschlossen</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_TerraMax" name="TerraMax (System)"><bpmn:flowNodeRef>Task_BesuchsplanErzeugen</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_GenugKunden</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_KeineTour</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_UeberspringenSpeichern</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_BesuchUebersprungen</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SprachnotizTranskribieren</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ProtokollentwurfErstellen</bpmn:flowNodeRef><bpmn:flowNodeRef>BoundaryEvent_TranskriptionFehlgeschlagen</bpmn:flowNodeRef><bpmn:flowNodeRef>BoundaryEvent_EntwurfFehlgeschlagen</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_EntwurfZusammenfuehren</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ProtokollZuordnen</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_BesuchDokumentiert</bpmn:flowNodeRef><bpmn:flowNodeRef>BoundaryEvent_TourAbgebrochen</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_TourEnde</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_TouruebersichtErstellen</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="StartEvent_TourAngefordert" name="Tour für einen Tag angefordert" camunda:initiator="initiator" camunda:formKey="terramax:tour-starten"><bpmn:documentation>Der Sales Professional wählt den Tag (tourDatum).</bpmn:documentation><bpmn:outgoing>Flow_Start_Plan</bpmn:outgoing></bpmn:startEvent><bpmn:serviceTask id="Task_BesuchsplanErzeugen" name="Besuchsplan erzeugen" camunda:delegateExpression="${besuchsplanErzeugen}"><bpmn:documentation>Wählt nach der MVP-Regel die Kunden aus und legt die Reihenfolge fest. Setzt besuchsplan (Liste der Kunden).</bpmn:documentation><bpmn:incoming>Flow_Start_Plan</bpmn:incoming><bpmn:outgoing>Flow_Plan_GenugKunden</bpmn:outgoing><bpmn:property id="Property_Task_BesuchsplanErzeugen" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DataInputAssociation_Task_BesuchsplanErzeugen"><bpmn:sourceRef>DataStoreReference_KundendatenLesen</bpmn:sourceRef><bpmn:targetRef>Property_Task_BesuchsplanErzeugen</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask><bpmn:exclusiveGateway id="Gateway_GenugKunden" name="Mindestens zwei Kunden?"><bpmn:incoming>Flow_Plan_GenugKunden</bpmn:incoming><bpmn:outgoing>Flow_GenugKunden_Nein</bpmn:outgoing><bpmn:outgoing>Flow_GenugKunden_Ja</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="EndEvent_KeineTour" name="Keine Tour möglich"><bpmn:incoming>Flow_GenugKunden_Nein</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_BesuchsplanPruefen" name="Besuchsplan prüfen" camunda:formKey="terramax:besuchsplan-pruefen" camunda:assignee="${initiator}"><bpmn:documentation>Zeigt Kunden und Reihenfolge. Der Sales Professional kann Kunden entfernen oder umsortieren und bestätigt den Plan oder verwirft die Tour. Setzt besuchsplan (angepasst) und planBestaetigt (Boolean). Bleiben nach dem Bearbeiten weniger als zwei Kunden übrig, erscheint die Aufgabe erneut mit dem Hinweis, mindestens zwei Kunden zu behalten.</bpmn:documentation><bpmn:incoming>Flow_PlanZusammen_Pruefen</bpmn:incoming><bpmn:outgoing>Flow_Pruefen_Bestaetigt</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_PlanZusammenfuehren"><bpmn:incoming>Flow_GenugKunden_Ja</bpmn:incoming><bpmn:incoming>Flow_NochGenug_Nein</bpmn:incoming><bpmn:outgoing>Flow_PlanZusammen_Pruefen</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="Gateway_PlanBestaetigt" name="Plan bestätigt?"><bpmn:incoming>Flow_Pruefen_Bestaetigt</bpmn:incoming><bpmn:outgoing>Flow_Bestaetigt_Nein</bpmn:outgoing><bpmn:outgoing>Flow_Bestaetigt_Ja</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="Gateway_NochGenugKunden" name="Noch mindestens zwei Kunden?"><bpmn:incoming>Flow_Bestaetigt_Ja</bpmn:incoming><bpmn:outgoing>Flow_NochGenug_Ja</bpmn:outgoing><bpmn:outgoing>Flow_NochGenug_Nein</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="EndEvent_TourVerworfen" name="Tour verworfen"><bpmn:incoming>Flow_Bestaetigt_Nein</bpmn:incoming></bpmn:endEvent><bpmn:subProcess id="SubProcess_KundenBesuchen" name="Kunden nacheinander besuchen"><bpmn:documentation>Wird für jeden Kunden des bestätigten Besuchsplans nacheinander ausgeführt (Multi-Instance, sequenziell). Lokale Variablen je Besuch verhindern, dass Entscheidungen eines Besuchs in den nächsten übernommen werden.</bpmn:documentation><bpmn:extensionElements><camunda:inputOutput><camunda:inputParameter name="besuchUeberspringen">${false}</camunda:inputParameter><camunda:inputParameter name="sprachnotizVorhanden">${false}</camunda:inputParameter></camunda:inputOutput></bpmn:extensionElements><bpmn:incoming>Flow_NochGenug_Ja</bpmn:incoming><bpmn:outgoing>Flow_Besuche_TourEnde</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${besuchsplan}" camunda:elementVariable="kunde" /><bpmn:startEvent id="StartEvent_BesuchFaellig" name="Besuch fällig"><bpmn:outgoing>Flow_BStart_Vorbereiten</bpmn:outgoing></bpmn:startEvent><bpmn:userTask id="Task_BesuchVorbereiten" name="Besuch vorbereiten" camunda:formKey="terramax:besuch-vorbereiten" camunda:assignee="${initiator}"><bpmn:documentation>Zeigt Kundendaten und die letzte Besuchshistorie des aktuellen Kunden (kunde). Der Sales Professional beginnt den Besuch oder überspringt ihn mit Grund. Setzt besuchUeberspringen (Boolean), ueberspringenGrund (Text) und beim Beginnen besuchBegonnenAm.</bpmn:documentation><bpmn:incoming>Flow_BStart_Vorbereiten</bpmn:incoming><bpmn:outgoing>Flow_Vorbereiten_Ueberspringen</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_BesuchUeberspringen" name="Besuch überspringen?"><bpmn:incoming>Flow_Vorbereiten_Ueberspringen</bpmn:incoming><bpmn:outgoing>Flow_Ueberspringen_Ja</bpmn:outgoing><bpmn:outgoing>Flow_Ueberspringen_Nein</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_UeberspringenSpeichern" name="Grund für Überspringen speichern" camunda:delegateExpression="${besuchUeberspringenSpeichern}"><bpmn:documentation>Speichert den übersprungenen Besuch mit ueberspringenGrund beim Kunden.</bpmn:documentation><bpmn:incoming>Flow_Ueberspringen_Ja</bpmn:incoming><bpmn:outgoing>Flow_Speichern_Uebersprungen</bpmn:outgoing></bpmn:serviceTask><bpmn:endEvent id="EndEvent_BesuchUebersprungen" name="Besuch übersprungen"><bpmn:incoming>Flow_Speichern_Uebersprungen</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="Task_BesuchDurchfuehren" name="Besuch durchführen" camunda:formKey="terramax:besuch-durchfuehren" camunda:assignee="${initiator}"><bpmn:documentation>Aktueller Besuch läuft (Status: begonnen). Mit dem Abschluss der Aufgabe markiert der Sales Professional den Besuch als abgeschlossen; setzt besuchAbgeschlossenAm.</bpmn:documentation><bpmn:incoming>Flow_Ueberspringen_Nein</bpmn:incoming><bpmn:outgoing>Flow_Durchfuehren_Notiz</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="Task_SprachnotizAufnehmen" name="Sprachnotiz aufnehmen" camunda:formKey="terramax:sprachnotiz" camunda:assignee="${initiator}"><bpmn:documentation>Optionale Sprachnotiz zum Gespräch (max. ca. 2 Minuten, Aufnahme im Browser). Setzt sprachnotizVorhanden (Boolean) und sprachnotizId (Referenz auf die gespeicherte Audiodatei).</bpmn:documentation><bpmn:incoming>Flow_Durchfuehren_Notiz</bpmn:incoming><bpmn:outgoing>Flow_Notiz_Vorhanden</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="Gateway_SprachnotizVorhanden" name="Sprachnotiz aufgenommen?"><bpmn:incoming>Flow_Notiz_Vorhanden</bpmn:incoming><bpmn:outgoing>Flow_Vorhanden_Ja</bpmn:outgoing><bpmn:outgoing>Flow_Vorhanden_Nein</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_SprachnotizTranskribieren" name="Sprachnotiz transkribieren" camunda:type="external" camunda:topic="sprachnotiz-transkribieren"><bpmn:documentation>External Task: Speech-to-Text, z. B. selbst gehostetes Whisper. Liest sprachnotizId, setzt transkript. Bei Fehler: BPMN-Fehler TRANSKRIPTION_FEHLGESCHLAGEN.</bpmn:documentation><bpmn:incoming>Flow_Vorhanden_Ja</bpmn:incoming><bpmn:outgoing>Flow_Transkript_Entwurf</bpmn:outgoing></bpmn:serviceTask><bpmn:serviceTask id="Task_ProtokollentwurfErstellen" name="Protokoll per KI entwerfen" camunda:type="external" camunda:topic="protokollentwurf-erstellen"><bpmn:documentation>External Task: Sprachmodell erzeugt aus transkript ein strukturiertes Kurzprotokoll (protokollEntwurf) mit den Feldern Gesprächspartner, Themen, Ergebnis, nächste Schritte und Follow-up-Datum; als KI-generiert markiert. Bei Fehler: BPMN-Fehler PROTOKOLLENTWURF_FEHLGESCHLAGEN.</bpmn:documentation><bpmn:incoming>Flow_Transkript_Entwurf</bpmn:incoming><bpmn:outgoing>Flow_Entwurf_ZusammenA</bpmn:outgoing></bpmn:serviceTask><bpmn:exclusiveGateway id="Gateway_EntwurfZusammenfuehren"><bpmn:incoming>Flow_Entwurf_ZusammenA</bpmn:incoming><bpmn:incoming>Flow_TranskriptFehler_ZusammenA</bpmn:incoming><bpmn:incoming>Flow_EntwurfFehler_ZusammenA</bpmn:incoming><bpmn:outgoing>Flow_ZusammenA_ZusammenB</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:exclusiveGateway id="Gateway_ProtokollZusammenfuehren"><bpmn:incoming>Flow_Vorhanden_Nein</bpmn:incoming><bpmn:incoming>Flow_ZusammenA_ZusammenB</bpmn:incoming><bpmn:outgoing>Flow_ZusammenB_Pruefen</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="Task_ProtokollPruefen" name="Protokoll prüfen und bestätigen" camunda:formKey="terramax:protokoll-pruefen" camunda:assignee="${initiator}"><bpmn:documentation>Zeigt den KI-Entwurf (gekennzeichnet) oder ein leeres Protokoll, wenn keine Sprachnotiz vorliegt oder ein Fehler auftrat. Alle Felder sind editierbar. Mit der Bestätigung wird protokoll gesetzt.</bpmn:documentation><bpmn:incoming>Flow_ZusammenB_Pruefen</bpmn:incoming><bpmn:outgoing>Flow_Pruefen_Zuordnen</bpmn:outgoing></bpmn:userTask><bpmn:serviceTask id="Task_ProtokollZuordnen" name="Protokoll dem Kunden zuordnen" camunda:delegateExpression="${protokollZuordnen}"><bpmn:documentation>Speichert das bestätigte Protokoll beim Kunden (erst nach Bestätigung).</bpmn:documentation><bpmn:incoming>Flow_Pruefen_Zuordnen</bpmn:incoming><bpmn:outgoing>Flow_Zuordnen_Dokumentiert</bpmn:outgoing><bpmn:dataOutputAssociation id="DataOutputAssociation_Task_ProtokollZuordnen"><bpmn:targetRef>DataStoreReference_KundendatenSchreiben</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask><bpmn:endEvent id="EndEvent_BesuchDokumentiert" name="Besuch dokumentiert"><bpmn:incoming>Flow_Zuordnen_Dokumentiert</bpmn:incoming></bpmn:endEvent><bpmn:boundaryEvent id="BoundaryEvent_TranskriptionFehlgeschlagen" name="Transkription fehlgeschlagen" attachedToRef="Task_SprachnotizTranskribieren"><bpmn:outgoing>Flow_TranskriptFehler_ZusammenA</bpmn:outgoing><bpmn:errorEventDefinition id="ErrorEventDefinition_Transkription" errorRef="Error_TranskriptionFehlgeschlagen" /></bpmn:boundaryEvent><bpmn:boundaryEvent id="BoundaryEvent_EntwurfFehlgeschlagen" name="Entwurf fehlgeschlagen" attachedToRef="Task_ProtokollentwurfErstellen"><bpmn:outgoing>Flow_EntwurfFehler_ZusammenA</bpmn:outgoing><bpmn:errorEventDefinition id="ErrorEventDefinition_Entwurf" errorRef="Error_ProtokollentwurfFehlgeschlagen" /></bpmn:boundaryEvent><bpmn:dataStoreReference id="DataStoreReference_KundendatenSchreiben" name="Kundendaten" dataStoreRef="DataStore_Kundendaten" /><bpmn:sequenceFlow id="Flow_BStart_Vorbereiten" sourceRef="StartEvent_BesuchFaellig" targetRef="Task_BesuchVorbereiten" /><bpmn:sequenceFlow id="Flow_Vorbereiten_Ueberspringen" sourceRef="Task_BesuchVorbereiten" targetRef="Gateway_BesuchUeberspringen" /><bpmn:sequenceFlow id="Flow_Ueberspringen_Ja" name="ja" sourceRef="Gateway_BesuchUeberspringen" targetRef="Task_UeberspringenSpeichern"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${besuchUeberspringen}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Ueberspringen_Nein" name="nein" sourceRef="Gateway_BesuchUeberspringen" targetRef="Task_BesuchDurchfuehren"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!besuchUeberspringen}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Speichern_Uebersprungen" sourceRef="Task_UeberspringenSpeichern" targetRef="EndEvent_BesuchUebersprungen" /><bpmn:sequenceFlow id="Flow_Durchfuehren_Notiz" sourceRef="Task_BesuchDurchfuehren" targetRef="Task_SprachnotizAufnehmen" /><bpmn:sequenceFlow id="Flow_Notiz_Vorhanden" sourceRef="Task_SprachnotizAufnehmen" targetRef="Gateway_SprachnotizVorhanden" /><bpmn:sequenceFlow id="Flow_Vorhanden_Ja" name="ja" sourceRef="Gateway_SprachnotizVorhanden" targetRef="Task_SprachnotizTranskribieren"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sprachnotizVorhanden}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Vorhanden_Nein" name="nein" sourceRef="Gateway_SprachnotizVorhanden" targetRef="Gateway_ProtokollZusammenfuehren"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!sprachnotizVorhanden}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Transkript_Entwurf" sourceRef="Task_SprachnotizTranskribieren" targetRef="Task_ProtokollentwurfErstellen" /><bpmn:sequenceFlow id="Flow_Entwurf_ZusammenA" sourceRef="Task_ProtokollentwurfErstellen" targetRef="Gateway_EntwurfZusammenfuehren" /><bpmn:sequenceFlow id="Flow_TranskriptFehler_ZusammenA" sourceRef="BoundaryEvent_TranskriptionFehlgeschlagen" targetRef="Gateway_EntwurfZusammenfuehren" /><bpmn:sequenceFlow id="Flow_EntwurfFehler_ZusammenA" sourceRef="BoundaryEvent_EntwurfFehlgeschlagen" targetRef="Gateway_EntwurfZusammenfuehren" /><bpmn:sequenceFlow id="Flow_ZusammenA_ZusammenB" sourceRef="Gateway_EntwurfZusammenfuehren" targetRef="Gateway_ProtokollZusammenfuehren" /><bpmn:sequenceFlow id="Flow_ZusammenB_Pruefen" sourceRef="Gateway_ProtokollZusammenfuehren" targetRef="Task_ProtokollPruefen" /><bpmn:sequenceFlow id="Flow_Pruefen_Zuordnen" sourceRef="Task_ProtokollPruefen" targetRef="Task_ProtokollZuordnen" /><bpmn:sequenceFlow id="Flow_Zuordnen_Dokumentiert" sourceRef="Task_ProtokollZuordnen" targetRef="EndEvent_BesuchDokumentiert" /></bpmn:subProcess><bpmn:boundaryEvent id="BoundaryEvent_TourAbgebrochen" name="Tour abgebrochen" attachedToRef="SubProcess_KundenBesuchen"><bpmn:outgoing>Flow_Abbruch_TourEnde</bpmn:outgoing><bpmn:messageEventDefinition id="MessageEventDefinition_TourAbbrechen" messageRef="Message_TourAbbrechen" /></bpmn:boundaryEvent><bpmn:exclusiveGateway id="Gateway_TourEnde"><bpmn:incoming>Flow_Besuche_TourEnde</bpmn:incoming><bpmn:incoming>Flow_Abbruch_TourEnde</bpmn:incoming><bpmn:outgoing>Flow_TourEnde_Uebersicht</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:serviceTask id="Task_TouruebersichtErstellen" name="Tourübersicht erstellen" camunda:delegateExpression="${touruebersichtErstellen}"><bpmn:documentation>Fasst alle Besuche der Tour zusammen: dokumentiert, übersprungen (mit Grund) oder wegen Abbruch offen.</bpmn:documentation><bpmn:incoming>Flow_TourEnde_Uebersicht</bpmn:incoming><bpmn:outgoing>Flow_Uebersicht_Abschliessen</bpmn:outgoing></bpmn:serviceTask><bpmn:userTask id="Task_TourAbschliessen" name="Tour abschließen" camunda:formKey="terramax:tour-uebersicht" camunda:assignee="${initiator}"><bpmn:documentation>Zeigt die Übersicht aller Besuche und Protokolle. Mit dem Abschluss endet die Tour.</bpmn:documentation><bpmn:incoming>Flow_Uebersicht_Abschliessen</bpmn:incoming><bpmn:outgoing>Flow_Abschliessen_Ende</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="EndEvent_TourAbgeschlossen" name="Tour abgeschlossen"><bpmn:incoming>Flow_Abschliessen_Ende</bpmn:incoming></bpmn:endEvent><bpmn:dataStoreReference id="DataStoreReference_KundendatenLesen" name="Kundendaten" dataStoreRef="DataStore_Kundendaten" /><bpmn:sequenceFlow id="Flow_Start_Plan" sourceRef="StartEvent_TourAngefordert" targetRef="Task_BesuchsplanErzeugen" /><bpmn:sequenceFlow id="Flow_Plan_GenugKunden" sourceRef="Task_BesuchsplanErzeugen" targetRef="Gateway_GenugKunden" /><bpmn:sequenceFlow id="Flow_GenugKunden_Nein" name="nein" sourceRef="Gateway_GenugKunden" targetRef="EndEvent_KeineTour"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${besuchsplan.size() &lt; 2}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_GenugKunden_Ja" name="ja" sourceRef="Gateway_GenugKunden" targetRef="Gateway_PlanZusammenfuehren"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${besuchsplan.size() &gt;= 2}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_PlanZusammen_Pruefen" sourceRef="Gateway_PlanZusammenfuehren" targetRef="Task_BesuchsplanPruefen" /><bpmn:sequenceFlow id="Flow_Pruefen_Bestaetigt" sourceRef="Task_BesuchsplanPruefen" targetRef="Gateway_PlanBestaetigt" /><bpmn:sequenceFlow id="Flow_Bestaetigt_Nein" name="nein" sourceRef="Gateway_PlanBestaetigt" targetRef="EndEvent_TourVerworfen"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!planBestaetigt}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Bestaetigt_Ja" name="ja" sourceRef="Gateway_PlanBestaetigt" targetRef="Gateway_NochGenugKunden"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${planBestaetigt}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_NochGenug_Ja" name="ja" sourceRef="Gateway_NochGenugKunden" targetRef="SubProcess_KundenBesuchen"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${besuchsplan.size() &gt;= 2}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_NochGenug_Nein" name="nein" sourceRef="Gateway_NochGenugKunden" targetRef="Gateway_PlanZusammenfuehren"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${besuchsplan.size() &lt; 2}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_Besuche_TourEnde" sourceRef="SubProcess_KundenBesuchen" targetRef="Gateway_TourEnde" /><bpmn:sequenceFlow id="Flow_Abbruch_TourEnde" sourceRef="BoundaryEvent_TourAbgebrochen" targetRef="Gateway_TourEnde" /><bpmn:sequenceFlow id="Flow_TourEnde_Uebersicht" sourceRef="Gateway_TourEnde" targetRef="Task_TouruebersichtErstellen" /><bpmn:sequenceFlow id="Flow_Uebersicht_Abschliessen" sourceRef="Task_TouruebersichtErstellen" targetRef="Task_TourAbschliessen" /><bpmn:sequenceFlow id="Flow_Abschliessen_Ende" sourceRef="Task_TourAbschliessen" targetRef="EndEvent_TourAbgeschlossen" /><bpmn:textAnnotation id="Annotation_Rolle"><bpmn:text>Nur Nutzer mit der Rolle »sales_professional« (Keycloak) dürfen eine Tour starten.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Annotation_Planregel"><bpmn:text>MVP-Regel: Kunden mit dem am längsten zurückliegenden Besuch, Reihenfolge nach Luftlinie ab Standort. Keine Routenoptimierung.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Annotation_Sprachnotiz"><bpmn:text>Optional, max. ca. 2 Minuten; Aufnahme im Browser.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="Annotation_KI"><bpmn:text>KI-Entwurf ist gekennzeichnet und editierbar. Gespeichert wird erst nach Bestätigung.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Association_Rolle" associationDirection="None" sourceRef="Annotation_Rolle" targetRef="StartEvent_TourAngefordert" /><bpmn:association id="Association_Planregel" associationDirection="None" sourceRef="Annotation_Planregel" targetRef="Task_BesuchsplanErzeugen" /><bpmn:association id="Association_Sprachnotiz" associationDirection="None" sourceRef="Annotation_Sprachnotiz" targetRef="Task_SprachnotizAufnehmen" /><bpmn:association id="Association_KI" associationDirection="None" sourceRef="Annotation_KI" targetRef="Task_ProtokollPruefen" /></bpmn:process>
