# Lokale Entwicklung gegen den Keycloak aus den Quarkus Dev Services (hello-service, Port 8180).
# Kopieren nach .env.local (wird nicht eingecheckt):  cp .env.local.example .env.local
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=terramax
VITE_KEYCLOAK_CLIENT_ID=publicClient
VITE_API_URL=http://localhost:8080
