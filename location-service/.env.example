# Umgebungsvariablen für den Betrieb des location-service (siehe README, Abschnitt "Betrieb").
# Nur Namen, keine Werte. Kopie als .env anlegen und lokal befüllen; .env wird nicht committet.

# Keycloak-Realm (Pflicht im Prod-Betrieb)
OIDC_AUTH_SERVER_URL=

# Erlaubte Frontend-Origins, kommagetrennt
CORS_ORIGINS=

# PostgreSQL
QUARKUS_DATASOURCE_JDBC_URL=
QUARKUS_DATASOURCE_USERNAME=
QUARKUS_DATASOURCE_PASSWORD=
