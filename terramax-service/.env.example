# Umgebungsvariablen für den Betrieb des terramax-service (siehe README, Abschnitt "Betrieb").
# Nur Namen, keine Werte. Kopie als .env anlegen und lokal befüllen; .env wird nicht committet.
# Im Portainer-Stack setzt docker-compose.yml diese Werte (dort mit QUARKUS_-Präfix für OIDC).

# Keycloak-Realm (Pflicht im Prod-Betrieb)
OIDC_AUTH_SERVER_URL=

# Erlaubte Frontend-Origins, kommagetrennt
CORS_ORIGINS=

# PostgreSQL
QUARKUS_DATASOURCE_JDBC_URL=
QUARKUS_DATASOURCE_USERNAME=
QUARKUS_DATASOURCE_PASSWORD=

# OpenAI, optional: Die LLM-Priorisierung ist auf Eis (terramax.prioritizer.mode bleibt stub).
# Ohne Key startet der Service normal
OPENAI_API_KEY=

# Optional: Testdaten-Import beim Start abschalten (Standard true)
TERRAMAX_SEED_ENABLED=

# Optional: Priorisierung umschalten (Standard stub; llm ist auf Eis)
TERRAMAX_PRIORITIZER_MODE=
